
generator client {
  provider = "prisma-client-ts"
  output = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_EXUCUTIVE_MEMBER
  SALES_EXUCUTIVE_TL
  SALES_EXUCUTIVE_MANAGER
  OPERATION
}

model User {
  id String @id @default(uuid())
  username String @unique
  passwordHash String @map("password_hash")
  fullName String @map("full_name")
  role Role @default(SALES_EXUCUTIVE_MEMBER)
  isActive Boolean @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")

}

enum duplicationStatus {
  REPEAT
  NEW
}

model Orders {
  id                    String            @id @default(uuid())
  employeeCode          String            @map("employee_code")
  custId                String
  PONumber              String            @map("po_number")
  PODate                DateTime          @map("po_date")
  shipDate              DateTime          @map("ship_date")
  partNumber            String            @map("part_number")
  partDescription       String            @map("part_description") @db.Text
  partDuplicationStatus duplicationStatus @default(NEW) @map("part_duplication_status")
  pricePerPiece         Decimal           @map("price_per_piece") @db.Decimal(12, 2)
  POQTY                 Int               @map("po_qty")

  catCode               String?           @map("cat_code")
  finishWeight          Decimal?           @map("finish_weight") @db.Decimal(12, 3)
  realisationPerKG      Decimal?           @map("realisation_per_kg") @db.Decimal(12, 3)

  boxQTY                Int?              @map("box_qty")
  bookingQty            Int?              @map("booking_qty")
  status                String            @default("PENDING")
  invoiceNumber         String?           @map("invoice_number")
  invoiceQTY            String?           @map("invoice_qty")

  @@map("orders")
}
